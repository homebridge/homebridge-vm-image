#!/bin/sh
#
# The hb-config tool of the Homebridge VM image ("sudo hb-config").
#
# The image build installs this file as /usr/local/sbin/hb-config.
#   - VMs made from an image up to November 2026 update the tool from this file on the "latest"
#     branch.
#   - Newer VMs update it from this file in the newest release (see do_update_tool below).
# So the file must stay at this path: assets/01-homebridge/files/hb-config
#
# This is a /bin/sh script. In the VM /bin/sh is dash, so bash-only syntax does not work here.
#
# When this file changes, set HB_CONFIG_VERSION below to the date of the change. "Update" only
# installs a tool with a newer version than the one that is running.
#

ASK_TO_REBOOT=0

# The version of this tool: the date of its last change. "Update" never replaces the tool with
# an older one. Change this value whenever this file changes.
HB_CONFIG_VERSION="2026.11.21"

calc_wt_size() {
  # NOTE: it's tempting to redirect stderr to /dev/null, so supress error
  # output from tput. However in this case, tput detects neither stdout or
  # stderr is a tty and so only gives default 80, 24 values
  WT_HEIGHT=17
  WT_WIDTH=$(tput cols)

  if [ -z "$WT_WIDTH" ] || [ "$WT_WIDTH" -lt 60 ]; then
    WT_WIDTH=80
  fi
  if [ "$WT_WIDTH" -gt 178 ]; then
    WT_WIDTH=120
  fi
  WT_MENU_HEIGHT=$((WT_HEIGHT - 7))
}

do_finish() {
  if [ "$ASK_TO_REBOOT" -eq 1 ]; then
    if whiptail --yesno "Would you like to reboot now?" 20 60 2; then
      sync
      reboot
    fi
  fi
  exit 0
}

HB_KEYRING=/usr/share/keyrings/homebridge.gpg
HB_APT_LIST=/etc/apt/sources.list.d/homebridge.list

# Prints the Homebridge package channel this system uses (stable, beta or alpha).
# It is read from the apt source file, so a user who chose beta stays on beta.
hb_apt_channel() {
  HB_CHANNEL=""
  if [ -f "$HB_APT_LIST" ]; then
    HB_CHANNEL=$(sed -n 's#^deb .*https://repo\.homebridge\.io/* \([a-z]*\) main.*#\1#p' "$HB_APT_LIST" | head -n 1)
  fi
  case "$HB_CHANNEL" in
    stable | beta | alpha) ;;
    *) HB_CHANNEL=stable ;;
  esac
  printf '%s\n' "$HB_CHANNEL"
}

# Downloads the key of the Homebridge package repo and writes the apt source file.
# The key in use is only replaced when the new one was downloaded and converted in full.
# Returns 1, and changes nothing, when that fails (for example with no network).
hb_refresh_apt_source() {
  HB_TMP=$(mktemp -d) || return 1
  if curl -sSfL https://repo.homebridge.io/KEY.gpg -o "$HB_TMP/KEY.gpg" \
    && gpg --dearmor < "$HB_TMP/KEY.gpg" > "$HB_TMP/homebridge.gpg" \
    && [ -s "$HB_TMP/homebridge.gpg" ]; then
    HB_CHANNEL=$(hb_apt_channel)
    install -m 644 "$HB_TMP/homebridge.gpg" "$HB_KEYRING"
    echo "deb [signed-by=$HB_KEYRING] https://repo.homebridge.io $HB_CHANNEL main" > "$HB_APT_LIST"
    rm -rf "$HB_TMP"
    return 0
  fi
  rm -rf "$HB_TMP"
  return 1
}

do_homebridge_update() {
  if pstree -s $$ | grep -q "hb-service"; then
    whiptail --title "Error" --msgbox "You cannot run this command from the Homebridge UI Terminal.\n\nPlease connect using SSH (see wiki for instructions) and try again." 20 60 1
    printf "\n"
    return
  fi

  if ! hb_refresh_apt_source; then
    whiptail --title "Error" --msgbox "The key of the Homebridge package repo could not be downloaded.\n\nCheck the network connection and try again. Nothing was changed." 20 60 1
    return
  fi

  if ! apt-get update --allow-releaseinfo-change; then
    whiptail --title "Error" --msgbox "The package lists could not be updated.\n\nCheck the network connection and try again. Homebridge was not changed." 20 60 1
    return
  fi

  if ! apt-get install -y homebridge; then
    whiptail --title "Error" --msgbox "The Homebridge package could not be updated. Review the log above." 20 60 1
  fi
}

do_restore_config() {
  if pstree -s $$ | grep -q "hb-service"; then
    whiptail --title "Error" --msgbox "You cannot run this command from the Homebridge UI Terminal.\n\nPlease connect using SSH (see wiki for instructions) and try again." 20 60 1
    printf "\n"
    return
  fi

  if ! whiptail --defaultno --yesno "This will DELETE ALL Homebridge data on this device:\n\n* the Homebridge config\n* all plugins and their settings\n* the accessory cache\n* the backups stored on this VM\n\nHomebridge is then installed again with its default settings. You will need to manually remove any existing connections to this instance in the iOS Home app.\n\nAre you sure you want to proceed?" 20 60 2; then
    return
  fi

  # Nothing is deleted before the package is on this device again: the key, the package lists
  # and the package file are downloaded first. With no network, this stops here.
  if ! hb_refresh_apt_source \
    || ! apt-get update --allow-releaseinfo-change \
    || ! apt-get install -y --download-only --reinstall homebridge; then
    whiptail --title "Error" --msgbox "The Homebridge package could not be downloaded.\n\nCheck the network connection and try again. Nothing was deleted." 20 60 1
    return
  fi

  apt-get purge -y homebridge

  if ! apt-get install -y homebridge; then
    whiptail --title "Error" --msgbox "Homebridge was removed, but it could not be installed again. Review the log above, then run:\n\nsudo apt-get install homebridge" 20 60 1
  fi
}

do_nodejs_update() {
  hb-service update-node
  exit 0
}

# use the utility /usr/local/sbin/expandVirtualFilesystem
do_expand_filesystem() {
  if ! whiptail --title "Warning" --yesno "This will expand the filesystem to use all available space on the virtual disk.\n\nThis operation may take several minutes to complete depending on the size of your virtual disk.\n\nAre you sure you want to continue?" 20 60 1; then
    return
  fi
  if /usr/local/sbin/expandVirtualFilesystem; then
    whiptail --title "Success" --msgbox "The filesystem now fills the virtual disk. No restart is needed.\n\nIf needed the output is here - /var/log/diskexpand.log" 20 60 1
  else
    whiptail --title "Error" --msgbox "An error occured while attempting to expand the filesystem. Pls see output here - /var/log/diskexpand.log" 20 60 1
  fi
}

get_hostname() {
  tr -d " \t\n\r" < /etc/hostname
}

do_hostname() {
  whiptail --msgbox "\
Please note: RFCs mandate that a hostname's labels \
may contain only the ASCII letters 'a' through 'z' (case-insensitive),
the digits '0' through '9', and the hyphen.
Hostname labels cannot begin or end with a hyphen.
No other symbols, punctuation characters, or blank spaces are permitted.\
" 20 70 1

  CURRENT_HOSTNAME=$(get_hostname)
  if ! NEW_HOSTNAME=$(whiptail --inputbox "Please enter a hostname" 20 60 "$CURRENT_HOSTNAME" 3>&1 1>&2 2>&3); then
    return
  fi

  # only a name that follows the rules above is used: it is written into system files
  if ! printf '%s' "$NEW_HOSTNAME" | grep -Eq '^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$'; then
    whiptail --title "Error" --msgbox "'$NEW_HOSTNAME' can not be used as a hostname. Nothing was changed." 20 60 1
    return
  fi

  if systemctl -q is-active dbus; then
    hostnamectl set-hostname "$NEW_HOSTNAME" 2> /dev/null
  fi
  echo "$NEW_HOSTNAME" > /etc/hostname
  sed -i "s/^127\.0\.1\.1.*$/127.0.1.1\t$NEW_HOSTNAME/" /etc/hosts
  whiptail --title "Success" --msgbox "The hostname has been changed to '$NEW_HOSTNAME'.\n\nYou need to reboot for the change to take full effect." 20 60 1
  ASK_TO_REBOOT=1
}

do_timezone() {
  dpkg-reconfigure tzdata
}

do_advanced_options() {
  FUN=$(whiptail --title "Homebridge VM Configuration Tool (hb-config)" --menu "Advanced Options" "$WT_HEIGHT" "$WT_WIDTH" "$WT_MENU_HEIGHT" --cancel-button Back --ok-button Select \
    "A1 Change Hostname" "Change hostname for this computer on a network" \
    "A2 Expand Filesystem" "Expand Virtual Filesystem to current allocation" \
    "A3 Change Timezone" "Choose the timezone of this VM" \
    3>&1 1>&2 2>&3)
  RET=$?
  if [ $RET -eq 1 ]; then
    return 0
  elif [ $RET -eq 0 ]; then
    case "$FUN" in
      A1\ *) do_hostname ;;
      A2\ *) do_expand_filesystem ;;
      A3\ *) do_timezone ;;
      *) whiptail --msgbox "Programmer error: unrecognized option" 20 60 1 ;;
    esac || whiptail --msgbox "There was an error running option $FUN" 20 60 1
  fi
}

# nginx 1.25.1 and newer want the line "http2 on;". Older versions (Debian 12 and before) do not
# know that line: they need "http2" on the "listen" lines. Returns 0 for the newer kind.
nginx_has_http2_setting() {
  NGINX_VERSION=$(nginx -v 2>&1 | sed -n 's#^nginx version: nginx/\([0-9][0-9.]*\).*#\1#p')
  [ -n "$NGINX_VERSION" ] && [ "$(printf '%s\n' "1.25.1" "$NGINX_VERSION" | sort -V | head -n 1)" = "1.25.1" ]
}

do_configure_nginx() {
  if ! whiptail --title "Warning" --yesno "Using this tool will overwrite any manual changes you may have made to the Homebridge Nginx config file.\n\nAre you sure you wish to continue?" 20 60 1; then
    return
  fi

  tempDir=$(mktemp -d) || return 1

  if ! whiptail --title "Homebridge VM Configuration Tool (hb-config)" --separate-output --checklist "\nNGINX Options:" 20 80 5 --cancel-button Cancel --ok-button Save \
    "1" "Listen on port 80 - http://        " 1 \
    "2" "Listen on port 443 - https://      " 1 \
    "3" "Redirect http:// to https://       " 0 2> "$tempDir/results"; then
    rm -rf "$tempDir"
    return
  fi

  LISTEN_ON_PORT_80=false
  LISTEN_ON_PORT_443=false
  REDIRECT_HTTP_TO_HTTPS=false

  while read -r choice; do
    case "$choice" in
      1) LISTEN_ON_PORT_80=true ;;
      2) LISTEN_ON_PORT_443=true ;;
      3) REDIRECT_HTTP_TO_HTTPS=true ;;
      *) ;;
    esac
  done < "$tempDir/results"

  rm -rf "$tempDir"

  NGINX_PORT_80_CONFIG=""
  if [ "$LISTEN_ON_PORT_80" = "true" ]; then
    NGINX_PORT_80_CONFIG="# http://
  listen 80;                  # http IPv4
  listen [::]:80;             # http IPv6
"
  fi

  NGINX_PORT_443_CONFIG=""
  if [ "$LISTEN_ON_PORT_443" = "true" ]; then
    if nginx_has_http2_setting; then
      NGINX_PORT_443_CONFIG="# https://
  listen 443 ssl;             # https IPv4
  listen [::]:443 ssl;        # https IPv6
  http2 on;
"
    else
      NGINX_PORT_443_CONFIG="# https://
  listen 443 ssl http2;       # https IPv4
  listen [::]:443 ssl http2;  # https IPv6
"
    fi
  fi

  NGINX_REDIRECT_HTTP_TO_HTTPS=""
  if [ "$REDIRECT_HTTP_TO_HTTPS" = "true" ] && [ "$LISTEN_ON_PORT_80" = "true" ]; then
    NGINX_PORT_80_CONFIG=""
    NGINX_REDIRECT_HTTP_TO_HTTPS="
server {
  listen 80;                  # http IPv4
  listen [::]:80;             # http IPv6

  # replace the _ with your domain name if required
  # eg.
  # server_name example.com;
  server_name _;

  return 302 https://\$host\$request_uri;
}"
  fi

  # the port of the Homebridge UI: digits only, or the default
  UI_PORT=$(cat /etc/hb-ui-port 2> /dev/null)
  case "$UI_PORT" in
    "" | *[!0-9]*) UI_PORT=8581 ;;
  esac

  NGINX_TEMPLATE="# this file was generated using the hb-config tool

server {
  $NGINX_PORT_80_CONFIG
  $NGINX_PORT_443_CONFIG
  # replace the _ with your domain name if required
  # eg.
  # server_name example.com;
  server_name _; # replace with your domain

  # path to ssl certificate file
  # If using Let's Encrypt replace this path with the location of the fullchain.pem file for your domain
  # eg.
  # ssl_certificate /etc/letsencrypt/live/example.com/fullchain.pem;
  ssl_certificate /etc/nginx/ssl/homebridge.local.crt;

  # path to ssl private key file
  # If using Let's Encrypt replace this path with the location of the privkey.pem file for your domain
  # eg.
  # ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;
  ssl_certificate_key /etc/nginx/ssl/homebridge.local.key;

  ssl_session_cache           builtin:1000  shared:SSL:10m;
  ssl_protocols               TLSv1.2 TLSv1.3;
  ssl_ciphers                 ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
  ssl_prefer_server_ciphers   off;
  # ssl_stapling                on;
  # ssl_stapling_verify         on;

  # large upload size to allow for uploading 3rd party backup files
  client_max_body_size 2G;

  error_page 502 /custom_502.html;

  location /startup-status.json {
    alias /usr/share/nginx/html/status.json;
  }

  location / {
    proxy_pass                  http://127.0.0.1:$UI_PORT;
    proxy_http_version          1.1;
    proxy_buffering             off;
    proxy_set_header            Host \$host;
    proxy_set_header            Upgrade \$http_upgrade;
    proxy_set_header            Connection \"Upgrade\";
    proxy_set_header            X-Real-IP \$remote_addr;
    proxy_set_header            X-Forwarded-For \$proxy_add_x_forwarded_for;
  }

  location = /custom_502.html {
    root /usr/share/nginx/html;
    internal;
  }
}
$NGINX_REDIRECT_HTTP_TO_HTTPS
"

  echo "$NGINX_TEMPLATE" > /etc/nginx/sites-available/homebridge.local
  /usr/local/sbin/nginx-homebridge-self-signed-cert
  systemctl enable nginx

  if systemctl is-active --quiet nginx.service; then
    echo "Restarting Nginx..."
    NGINX_ACTION=restart
  else
    echo "Starting Nginx..."
    NGINX_ACTION=start
  fi

  if systemctl "$NGINX_ACTION" nginx; then
    whiptail --title "Success" --msgbox "NGINX has been configured successfully." 20 60 1
  else
    whiptail --title "Error" --msgbox "An error occured while attempting to reload the NGINX config." 20 60 1
  fi
}

# version_older <a> <b>: true when version a is older than version b
version_older() {
  [ "$1" != "$2" ] && [ "$(printf '%s\n' "$1" "$2" | sort -V | head -n 1)" = "$1" ]
}

HB_IMAGE_REPO_URL=https://github.com/homebridge/homebridge-vm-image
HB_IMAGE_RAW_URL=https://raw.githubusercontent.com/homebridge/homebridge-vm-image

# Prints the tag of the newest stable image release (for example 2026-11-21), or nothing when it
# can not be found. GitHub sends ".../releases/latest" on to ".../releases/tag/<tag>".
hb_latest_release_tag() {
  curl -sSfIL -o /dev/null -w '%{url_effective}' "$HB_IMAGE_REPO_URL/releases/latest" 2> /dev/null \
    | sed -n 's#^.*/releases/tag/\([0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]\)$#\1#p'
}

# Menu entry "Update"
do_update() {
  do_update_tool
}

do_update_tool() {
  tempDir=$(mktemp -d) || return 1

  # The tool is taken from the newest release, not from the tip of the branch. So what is
  # installed here went through a release build (with its boot test) first.
  releaseTag=$(hb_latest_release_tag)
  if [ -z "$releaseTag" ]; then
    rm -rf "$tempDir"
    whiptail --title "Error" --msgbox "The newest release could not be found.\n\nCheck the network connection and try again." 20 60 1
    return
  fi

  scriptUrl="$HB_IMAGE_RAW_URL/$releaseTag/assets/01-homebridge/files/hb-config"
  printf 'Downloading hb-config from release %s...\n%s\n' "$releaseTag" "$scriptUrl"

  if ! curl -fL# "$scriptUrl" -o "$tempDir/hb-config"; then
    rm -rf "$tempDir"
    whiptail --title "Error" --msgbox "An error occured while attempting to update the hb-config tool." 20 60 1
    return
  fi

  # The download must be a complete script for the shell that runs this tool (/bin/sh).
  if [ ! -s "$tempDir/hb-config" ] || [ "$(head -n 1 "$tempDir/hb-config")" != "#!/bin/sh" ] || ! sh -n "$tempDir/hb-config"; then
    rm -rf "$tempDir"
    whiptail --title "Error" --msgbox "The downloaded script was corrupted and did not pass the syntax check. The tool was not changed." 20 60 1
    return
  fi

  # Never go back to an older tool. (Right after this tool changed, the newest release can
  # still hold the tool from before the change.)
  newVersion=$(sed -n 's/^HB_CONFIG_VERSION="\([0-9][0-9.]*\)"$/\1/p' "$tempDir/hb-config" | head -n 1)
  if [ "${newVersion:-0}" = "$HB_CONFIG_VERSION" ] || version_older "${newVersion:-0}" "$HB_CONFIG_VERSION"; then
    rm -rf "$tempDir"
    whiptail --title "Up to date" --msgbox "The hb-config tool is already up to date (version $HB_CONFIG_VERSION).\n\nThe newest release ($releaseTag) has no newer one." 20 60 1
    return
  fi

  install -m 755 "$tempDir/hb-config" /usr/local/sbin/hb-config
  rm -rf "$tempDir"
  whiptail --title "Success" --msgbox "The hb-config tool has been updated to the one from release $releaseTag and will now exit.\n\nIf you like the Homebridge VM image please show your support by starring the project on GitHub:\n\nhttps://github.com/homebridge/homebridge-vm-image" 20 60 1
  exit 0
}

do_about() {
  IMAGE_VERSION=$(cat /etc/hb-release)

  whiptail --title "About" --msgbox "\
This tool provides a straight-forward way of managing Homebridge on a VM. Although it can be run at any time, some of the options may have difficulties if you have heavily customised your installation.

Image Version: $IMAGE_VERSION
Tool Version: $HB_CONFIG_VERSION

Homebridge - @homebridge
https://github.com/homebridge/homebridge

Homebridge Config UI X - @homebridge
https://github.com/homebridge/homebridge-config-ui-x

Homebridge VM Image - @homebridge
https://github.com/homebridge/homebridge-vm-image


\
" 20 80 1
}

# Everything else needs to be run as root
if [ "$(id -u)" -ne 0 ]; then
  printf "Script must be run as root. Try 'sudo hb-config'\n"
  exit 1
fi

#
# Interactive use loop
#
calc_wt_size

while true; do
  FUN=$(whiptail --title "Homebridge VM Image Configuration Tool (hb-config)" --menu "Setup Options" "$WT_HEIGHT" "$WT_WIDTH" "$WT_MENU_HEIGHT" --cancel-button Finish --ok-button Select \
    "1 Update Node.js" "Update Node.js to the newest version Homebridge supports" \
    "2 Update Homebridge" "Update Homebridge and Node.js to the latest version using apt-pkg" \
    "3 Restore Config" "Delete config, plugins and backups, then install Homebridge again" \
    "4 Nginx Options" "Configure Homebridge Nginx settings" \
    "5 Advanced Options" "Advanced Options ie expand file system, hostname, timezone" \
    "8 Update" "Update this tool to the latest version" \
    "9 About" "Information about this configuration tool" \
    3>&1 1>&2 2>&3)
  RET=$?
  if [ $RET -eq 1 ]; then
    do_finish
  elif [ $RET -eq 0 ]; then
    case "$FUN" in
      1\ *) do_nodejs_update ;;
      2\ *) do_homebridge_update ;;
      3\ *) do_restore_config ;;
      4\ *) do_configure_nginx ;;
      5\ *) do_advanced_options ;;
      8\ *) do_update ;;
      9\ *) do_about ;;
      *) whiptail --msgbox "Programmer error: unrecognized option" 20 60 1 ;;
    esac || whiptail --msgbox "There was an error running option $FUN" 20 60 1
  else
    exit 1
  fi
done

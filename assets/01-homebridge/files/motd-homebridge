#!/bin/bash

RED='\033[0;31m'
GREEN='\033[0;32m'
BOLD='\033[1m'
NC='\033[0m'

# Get system info appropriate for VM
HOSTNAME=$(hostname)

IP=$(hostname -I)
UI_PORT=$(cat /etc/hb-ui-port)
IMAGE_VERSION=$(cat /etc/hb-release)

# label <text> <value>: one line with a bold label and a green value
label() { printf '%b%s%b %b%s%b\n' "$BOLD" "$1" "$NC" "$GREEN" "$2" "$NC"; }
# address <url>: one line of the list of web addresses
address() { printf '%b*%b %b%s%b\n' "$BOLD" "$NC" "$GREEN" "$1" "$NC"; }

printf '\n%b*** Homebridge VM Image %s ***%b\n\n' "$RED" "$IMAGE_VERSION" "$NC"

printf "homebridge was created by nfarina and licensed under the Apache License 2.0.\n" | fold -s
printf "homebridge-config-ui-x was created by oznu and licensed under the MIT License.\n\n" | fold -s

printf "To configure Homebridge browse to the one of the following addresses from another device on your network:" | fold -s
printf "\n\n"
address "http://${HOSTNAME}.local:${UI_PORT}"

for ip in $IP; do
  if [[ $ip =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    address "http://${ip}:${UI_PORT}"
  else
    address "http://[${ip}]:${UI_PORT}"
  fi
done

printf "\nAll Homebridge configuration can be completed via the Homebridge Web UI.\n" | fold -s

printf '\n'
label "Homebridge storage path:" "/var/lib/homebridge"
label "Homebridge config.json path:" "/var/lib/homebridge/config.json"

printf '\n'
label "Restart Homebridge CMD:" "sudo hb-service restart"
label "View Logs CMD:" "sudo hb-service logs"

printf '\n'
label "Manage Server:" "sudo hb-config"
label "Enter Homebridge Runtime Environment:" "sudo hb-shell"

printf "\n"

[Unit]
Description=First Boot Homebridge Setup
# The wizard runs on the screen console, before the login prompt of that console.
# It must NOT be ordered after multi-user.target: the login prompts are part of that target, so
# "after the target, before the login prompt" is a loop, and systemd then drops a job to break it.
After=systemd-user-sessions.service
Before=getty@tty1.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/first-boot-homebridge
StandardInput=tty
StandardOutput=inherit
StandardError=inherit
TTYPath=/dev/tty1
RemainAfterExit=true

[Install]
WantedBy=multi-user.target

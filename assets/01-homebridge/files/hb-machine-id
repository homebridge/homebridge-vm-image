#!/bin/sh
# Gives this VM a machine id of its own.
#
# The image holds an empty /etc/machine-id (scripts/seal-image.sh). On the first start systemd
# fills it, and in a VM it takes the VM's UUID for that. A UTM package carries a fixed UUID (UTM
# will not import a package without one), so every VM made from the same package would get the
# same machine id. When the id is the VM's UUID, this replaces it with a new random one. It runs
# early at every start and does nothing once the id is not the VM's UUID. The rest of the start in
# which the id is replaced still runs with the old id; every later start uses the new one.
#
# HB_MACHINE_ID_FILE and HB_PRODUCT_UUID_FILE are only set by the tests.

set -eu

ID_FILE="${HB_MACHINE_ID_FILE:-/etc/machine-id}"
UUID_FILE="${HB_PRODUCT_UUID_FILE:-/sys/class/dmi/id/product_uuid}"

# no VM UUID to compare with (not a VM, or the firmware does not give one): nothing to do
[ -r "$UUID_FILE" ] || exit 0
VM_UUID="$(tr -d -- '-' < "$UUID_FILE" | tr 'A-F' 'a-f')"
MACHINE_ID="$(cat "$ID_FILE" 2> /dev/null || true)"

if [ -z "$VM_UUID" ] || [ "$MACHINE_ID" != "$VM_UUID" ]; then
  exit 0
fi

NEW_ID="$(systemd-id128 new)"
printf '%s\n' "$NEW_ID" > "$ID_FILE"
echo "hb-machine-id: the machine id was the VM's UUID; this VM now has a random one of its own"

#!/bin/bash
#
# Grows the root (/) ext4 file system to fill the virtual disk.
#
# It runs at every start of the VM (hb-expand-rootfs.service) and from "sudo hb-config".
# Most of the time there is nothing to do, and it changes nothing. It only does something after
# the virtual disk was made larger in the VM program.
#
# Exit code 0: the file system fills the disk (grown now, or it already did).
# Exit code 1: something failed. The output says what. The log is /var/log/diskexpand.log.

set -u

# Define color codes for logging
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Log helper functions
warn() { echo -e "${YELLOW}WARN:${NC} $*" >&2; }
error() { echo -e "${RED}ERROR:${NC} $*" >&2; }
info() { echo -e "$*" >&2; }

LOGFILE="/var/log/diskexpand.log"

expand() {
    info "================================"
    info "Auto-Expand Root Filesystem"
    info "================================"
    info "Started at: $(date)"

    if [ "$(id -u)" -ne 0 ]; then
        error "This script must be run as root"
        error "Please run: sudo $0"
        return 1
    fi

    # The device mounted at /, for example /dev/sda2, /dev/vda2 or /dev/nvme0n1p2
    local root_partition fs_type part_name disk_name part_num device
    root_partition=$(findmnt -n -o SOURCE /)
    fs_type=$(findmnt -n -o FSTYPE /)
    info "Root partition: ${GREEN}${root_partition}${NC} (${fs_type})"

    if [ "$fs_type" != "ext4" ]; then
        error "Root filesystem is ${fs_type:-unknown}, not ext4"
        error "This script only supports ext4 filesystems"
        return 1
    fi

    # The disk and the partition number are asked from the system. They are not cut out of the
    # name: "the digits at the end" is right for sda2, and wrong for nvme0n1p2 or mmcblk0p2.
    part_name=$(basename "$root_partition")
    disk_name=$(lsblk -no PKNAME "$root_partition" 2> /dev/null | head -n 1)
    part_num=$(cat "/sys/class/block/${part_name}/partition" 2> /dev/null)

    if [ -n "$disk_name" ] && [ -n "$part_num" ]; then
        device="/dev/${disk_name}"
        info "Device: ${BLUE}${device}${NC}, partition number: ${BLUE}${part_num}${NC}"

        if ! command -v growpart > /dev/null 2>&1; then
            error "growpart not found. Install it with: sudo apt-get install cloud-guest-utils"
            return 1
        fi

        # growpart ends with code 0 when it grew the partition, and prints NOCHANGE (code 1)
        # when the partition already fills the disk. Anything else is a failure.
        local grow_output grow_code
        grow_output=$(growpart "$device" "$part_num" 2>&1)
        grow_code=$?
        info "$grow_output"
        if [ "$grow_code" -eq 0 ]; then
            info "${GREEN}Partition expanded successfully${NC}"
            # tell the kernel about the new size (growpart does this too; this is a second try)
            partx -u "$device" 2> /dev/null || true
        elif printf '%s' "$grow_output" | grep -q "NOCHANGE"; then
            info "Partition is already at maximum size"
        else
            error "growpart failed with code ${grow_code}. The partition was not changed."
            return 1
        fi
    else
        # for example a file system that sits on the whole disk, with no partitions
        warn "${root_partition} is not a partition of a disk. Only the file system is grown."
    fi

    # Grow the file system into the partition. This works while the system runs, and it does
    # nothing when the file system already fills the partition.
    info "Expanding ext4 filesystem..."
    if ! resize2fs "$root_partition"; then
        error "resize2fs failed. The file system was not changed."
        return 1
    fi

    info "Disk usage now:"
    df -h /
    info "${GREEN}Root filesystem expansion complete!${NC}"
    info "Completed at: $(date)"
}

# the output goes to the screen (or the journal) and to the log file
expand 2>&1 | tee -a "$LOGFILE"
exit "${PIPESTATUS[0]}"

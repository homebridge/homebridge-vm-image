#!/bin/bash

# Script to expand the ext4 filesystem on the root partition to use all available disk space
# Designed for UTM VMs with qcow2 disks (e.g., Homebridge VM image)
# Uses libguestfs-tools for inspection, logs output, errors, and available disk space to /var/log/diskexpand.log

# Exit on any error
set -e

# Log file
LOGFILE="/var/log/diskexpand.log"

# Function to log messages
log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" | tee -a "$LOGFILE"
}

# Check if script has already run
FLAGFILE="/var/lib/diskexpand.done"
if [ -f "$FLAGFILE" ]; then
    log "Disk expansion already completed. Exiting."
    exit 0
fi

# Check if libguestfs-tools is installed
if ! command -v virt-filesystems &> /dev/null; then
    log "ERROR: libguestfs-tools not installed. Exiting."
    exit 1
fi

# Identify the root disk and partition
ROOT_DEV=$(df / | grep -Eo '/dev/[a-zA-Z0-9]+' | head -1)
if [ -z "$ROOT_DEV" ]; then
    log "ERROR: Could not identify root partition."
    exit 1
fi
DISK=$(echo "$ROOT_DEV" | sed 's/[0-9]*$//')
PART_NUM=$(echo "$ROOT_DEV" | grep -o '[0-9]*$')
log "Root partition: $ROOT_DEV, Disk: $DISK, Partition number: $PART_NUM"

# Use virt-filesystems to inspect the disk
log "Inspecting disk $DISK with virt-filesystems"
virt-filesystems --long --all --blkdevs "$DISK" 2>&1 | tee -a "$LOGFILE"

# Verify filesystem is ext4
FSTYPE=$(blkid -o value -s TYPE "$ROOT_DEV")
if [ "$FSTYPE" != "ext4" ]; then
    log "ERROR: Root filesystem is $FSTYPE, not ext4. Exiting."
    exit 1
fi
log "Confirmed ext4 filesystem on $ROOT_DEV"

# Check disk and partition sizes
DISK_SIZE=$(lsblk -b -d -n -o SIZE "$DISK")
PART_SIZE=$(lsblk -b -n -o SIZE "$ROOT_DEV")
log "Disk size: $DISK_SIZE bytes, Partition size: $PART_SIZE bytes"

# Only proceed if disk is larger than partition
if [ "$DISK_SIZE" -le "$PART_SIZE" ]; then
    log "No additional disk space to expand. Exiting."
    exit 0
fi

# Log available disk space before expansion
log "Available disk space before expansion:"
df -h / | tee -a "$LOGFILE"

# Get the start sector of the root partition
PART_START=$(parted -s "$DISK" unit s print | grep "^ $PART_NUM" | awk '{print $2}')
log "Root partition starts at sector: $PART_START"

# Resize the partition using parted
log "Resizing partition $ROOT_DEV to use all available space"
parted -s "$DISK" resizepart "$PART_NUM" 100% 2>&1 | tee -a "$LOGFILE"

# Notify kernel of partition table changes
log "Notifying kernel of partition table changes"
partprobe "$DISK" 2>&1 | tee -a "$LOGFILE"

# Force a filesystem check
log "Checking filesystem on $ROOT_DEV"
fsck.ext4 -f -y "$ROOT_DEV" 2>&1 | tee -a "$LOGFILE"

# Resize the ext4 filesystem
log "Resizing ext4 filesystem on $ROOT_DEV"
resize2fs "$ROOT_DEV" 2>&1 | tee -a "$LOGFILE"

# Log available disk space after expansion
log "Available disk space after expansion:"
df -h / | tee -a "$LOGFILE"

# Verify new filesystem size
NEW_SIZE=$(df -h / | grep -Eo '[0-9.]+[GM]' | head -1)
log "Filesystem resized. New size: $NEW_SIZE"

# Mark script as completed
touch "$FLAGFILE"
log "Disk expansion completed successfully."

exit 0